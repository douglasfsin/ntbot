<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&family=Syne:wght@600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="@Assets["css/design-system.css"]" />
    <link rel="stylesheet" href="@Assets["css/auth.css"]" />
    <link rel="stylesheet" href="@Assets["css/app-pages.css"]" />
    <link rel="stylesheet" href="@Assets["css/trading-intelligence.css"]" />
    <link rel="stylesheet" href="@Assets["css/nomos-home.css"]" />
    <link rel="stylesheet" href="@Assets["NtBot.Web.styles.css"]" />
    <ImportMap />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <script src="@Assets["js/ntbot.js"]"></script>
    <script src="https://unpkg.com/lightweight-charts@4.2.0/dist/lightweight-charts.standalone.production.js"></script>
    <script src="@Assets["js/ti-chart.js"]"></script>
    <script src="_framework/blazor.web.js" autostart="false"></script>
    <script>
        Blazor.start({
            circuit: {
                configureSignalR: function (builder) {
                    if (typeof builder.withServerTimeout === 'function')
                        builder.withServerTimeout(90000);
                    if (typeof builder.withKeepAliveInterval === 'function')
                        builder.withKeepAliveInterval(15000);
                },
                reconnectionOptions: {
                    maxRetries: 20,
                    retryIntervalMilliseconds: 3000
                }
            }
        });
    </script>
</body>

</html>
